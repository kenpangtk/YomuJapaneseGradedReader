{
  "name": "yomu-graded-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-kuromoji.mjs && vite",
    "build": "node scripts/copy-kuromoji.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
